# =============================================================================
# Variables del frontend (Vite)
#
# OJO: todo lo que empiece por VITE_ queda EMBEBIDO en el bundle y es público.
# Nunca pongas secretos aquí.
#
# Este archivo es el valor por defecto para desarrollo. En Vercel hay que
# definir las mismas variables en Settings -> Environment Variables, porque el
# build de producción usa esas y no este archivo.
# =============================================================================

# URL del backend NestJS.
#   local     -> http://localhost:3000
#   en Vercel -> https://gerenteai.onrender.com
VITE_API_URL=http://localhost:3000

# Número de WhatsApp de Luka, en formato internacional y solo dígitos.
# A este chat se manda al usuario apenas termina de registrarse.
# El valor de abajo es el número de PRUEBA de Meta: solo puede escribirle a los
# destinatarios autorizados. En Vercel hay que poner el número de producción.
VITE_WHATSAPP_NUMBER=15551580873
