    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL || 'https://TU-BACKEND.up.railway.app' }}/ai/interpret",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.fromEntries(Object.entries({ message: $json.message, phone: $json.phone, userId: $json.userId, username: $json.username, name: $json.name, conversationId: $json.conversationId, messageId: $json.messageId, quotedMessageId: $json.quotedMessageId, media: $json.media }).filter(([, v]) => v !== undefined && v !== null && v !== ''))) }}",
        "options": {
          "timeout": 90000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        880,
        60
