    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $env.WHATSAPP_API_VERSION || 'v25.0' }}/{{ $env.WHATSAPP_PHONE_NUMBER_ID || '1276800955509419' }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', recipient_type: 'individual', to: $json.destinatario, type: 'text', text: { preview_url: false, body: $json.reply } }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1540,
        -20
      ],
      "id": "a1000000-0000-4000-8000-000000000013",
      "name": "Enviar WhatsApp",
      "credentials": {
        "httpBearerAuth": {
          "id": "Pjjumysctcj1HMVh",
          "name": "Bearer Auth account"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "notes": "El destinatario puede ser un telefono o una identidad de WhatsApp (user_id) para las cuentas que ocultan su numero. La Graph API acepta ambos en el campo \"to\".\nEl cuerpo se construye con JSON.stringify: los resumenes traen saltos de linea y emojis, y escribir el JSON a mano los rompe."
    },
    {
      "parameters": {
        "jsCode": "// Falló el envío a Meta (token vencido, número fuera de la ventana de 24 h,\n// límite de la API...). Se deja traza clara en el log de la ejecución.\nfor (const item of $input.all()) {\n  console.log('[WhatsApp] ERROR de envío:', JSON.stringify(item.json).slice(0, 1000));\n}\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        80
      ],
      "id": "a1000000-0000-4000-8000-000000000014",
      "name": "Registrar fallo de envío"
    },
