      "name": "Responder 200 a Meta",
      "notes": "Se responde ANTES de procesar: Meta corta a los 20 s y reintenta el evento si no recibe 200."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
