              "leftValue": "={{ $json.body.entry[0].changes[0].value.messages?.[0]?.from || $json.body.entry[0].changes[0].value.contacts?.[0]?.wa_id || $json.body.entry[0].changes[0].value.messages?.[0]?.from_user_id || $json.body.entry[0].changes[0].value.contacts?.[0]?.user_id || '' }}",
