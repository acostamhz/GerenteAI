        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $env.WHATSAPP_API_VERSION || 'v25.0' }}/{{ $env.WHATSAPP_PHONE_NUMBER_ID || '1276800955509419' }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ messaging_product: 'whatsapp', recipient_type: 'individual' }, $json.destinatario.includes('.') ? { recipient: $json.destinatario } : { to: $json.destinatario }, { type: 'text', text: { preview_url: false, body: $json.reply } })) }}",
        "options": {
          "timeout": 15000
