              "value": "={{ $json.body.entry[0].changes[0].value.messages[0].id }}",
              "type": "string"
            },
            {
              "id": "c1-userId",
              "name": "userId",
              "value": "={{ $json.body.entry[0].changes[0].value.messages?.[0]?.from_user_id || $json.body.entry[0].changes[0].value.contacts?.[0]?.user_id || '' }}",
              "type": "string"
            },
            {
              "id": "c1-username",
              "name": "username",
              "value": "={{ $json.body.entry[0].changes[0].value.contacts?.[0]?.username || '' }}",
              "type": "string"
            },
            {
              "id": "c1-destinatario",
              "name": "destinatario",
              "value": "={{ $json.body.entry[0].changes[0].value.messages?.[0]?.from || $json.body.entry[0].changes[0].value.contacts?.[0]?.wa_id || $json.body.entry[0].changes[0].value.messages?.[0]?.from_user_id || $json.body.entry[0].changes[0].value.contacts?.[0]?.user_id || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        660,
        60
      ],
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Extraer datos",
      "notes": "Meta identifica a quien escribe de dos formas:\n  - telefono: messages[0].from (o contacts[0].wa_id)\n  - identidad: messages[0].from_user_id (o contacts[0].user_id), para las cuentas que activaron el nombre de usuario de WhatsApp y ocultan su numero\nSe extraen las dos y \"destinatario\" es la que se usa para responder. El backend acepta phone, userId o ambos."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL || 'https://TU-BACKEND.up.railway.app' }}/ai/interpret",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.fromEntries(Object.entries({ message: $json.message, phone: $json.phone, userId: $json.userId, username: $json.username, name: $json.name, conversationId: $json.conversationId, messageId: $json.messageId }).filter(([, v]) => v !== undefined && v !== null && v !== ''))) }}",
        "options": {
          "timeout": 90000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        880,
        60
      ],
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Interpretar con IA",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_ID_CREDENCIAL",
          "name": "Backend Luka AI (x-api-key)"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "notes": "Timeout 90 s: si Render tenia el servicio dormido, el arranque en frio se lleva 30-60 s. Con 45 s el primer mensaje del dia se perdia por timeout.\nn8n ya respondio 200 a Meta antes de este nodo, asi que esperar de mas no rompe nada: el usuario solo tarda mas en recibir la respuesta.\n2 intentos. Si aun asi falla, sale por la salida roja y el usuario recibe el mensaje de emergencia.\nEl body se arma con JSON.stringify: si se escribiera a mano, un mensaje con comillas o saltos de linea romperia el JSON."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1000000-0000-4000-8000-000000000010",
              "name": "destinatario",
              "value": "={{ $('Extraer datos').item.json.destinatario }}",
              "type": "string"
            },
            {
              "id": "c1000000-0000-4000-8000-000000000011",
              "name": "reply",
              "value": "={{ $json.reply }}",
              "type": "string"
            },
            {
              "id": "c1000000-0000-4000-8000-000000000012",
              "name": "tipo",
              "value": "={{ $json.interpreted?.type || 'desconocido' }}",
              "type": "string"
            },
            {
              "id": "c1000000-0000-4000-8000-000000000013",
              "name": "guardado",
              "value": "={{ $json.interpreted?.saved === true }}",
              "type": "boolean"
            },
            {
              "id": "c1000000-0000-4000-8000-000000000014",
              "name": "confianza",
              "value": "={{ $json.interpreted?.confidence ?? 0 }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1100,
        -40
      ],
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Preparar respuesta",
      "notes": "tipo/guardado/confianza no se envían al usuario: quedan en el historial de ejecuciones para depurar."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1000000-0000-4000-8000-000000000020",
              "name": "destinatario",
              "value": "={{ $('Extraer datos').item.json.destinatario }}",
              "type": "string"
            },
            {
              "id": "c1000000-0000-4000-8000-000000000021",
              "name": "reply",
              "value": "😔 No pude procesar tu mensaje en este momento. Intenta de nuevo en unos minutos y lo registro sin problema.",
              "type": "string"
            },
            {
              "id": "c1000000-0000-4000-8000-000000000022",
              "name": "tipo",
              "value": "error_backend",
              "type": "string"
            },
            {
              "id": "c1000000-0000-4000-8000-000000000023",
              "name": "detalleError",
              "value": "={{ JSON.stringify($json.error ?? $json).slice(0, 500) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
