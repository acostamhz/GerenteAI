generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLEADO
  CONTADOR
}

enum TipoVenta {
  CONTADO
  FIADO
}

enum CategoriaGasto {
  ARRIENDO
  SERVICIOS
  NOMINA
  TRANSPORTE
  OTROS
}

model Negocio {
  id                 String   @id @default(uuid())
  nombre             String
  telefono           String   @unique
  telefonoSecundario String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  usuariosNegocio UsuarioNegocio[]
  productos       Producto[]
  clientes        Cliente[]
  proveedores     Proveedor[]
  ventas          Venta[]
  compras         Compra[]
  gastos          Gasto[]
}

model Usuario {
  id        String   @id @default(uuid())
  nombre    String
  telefono  String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  negocios UsuarioNegocio[]
}

model UsuarioNegocio {
  id        String @id @default(uuid())
  role      Role   @default(ADMIN)

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  negocioId String
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, negocioId])
}

model Producto {
  id           String   @id @default(uuid())
  nombre       String
  stock        Int      @default(0)
  stockMinimo  Int      @default(0)
  precioCompra Decimal
  precioVenta  Decimal

  negocioId String
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  detallesVenta  DetalleVenta[]
  detallesCompra DetalleCompra[]
}

model Cliente {
  id             String   @id @default(uuid())
  nombre         String
  telefono       String?
  saldoPendiente Decimal  @default(0.0)

  negocioId String
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  ventas Venta[]
}

model Proveedor {
  id        String  @id @default(uuid())
  nombre    String
  telefono  String?
  correo    String?
  direccion String?

  negocioId String
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  compras Compra[]
}

model Venta {
  id     String    @id @default(uuid())
  tipo   TipoVenta @default(CONTADO)
  total  Decimal
  fecha  DateTime  @default(now())

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  negocioId String
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  detalles DetalleVenta[]
}

model DetalleVenta {
  id       String  @id @default(uuid())
  cantidad Int
  precio   Decimal

  ventaId String
  venta   Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model Compra {
  id    String   @id @default(uuid())
  total Decimal
  fecha DateTime @default(now())

  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)

  negocioId String
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  detalles DetalleCompra[]
}

model DetalleCompra {
  id       String  @id @default(uuid())
  cantidad Int
  costo    Decimal

  compraId String
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model Gasto {
  id          String         @id @default(uuid())
  descripcion String
  monto       Decimal
  categoria   CategoriaGasto
  fecha       DateTime       @default(now())

  negocioId String
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
}