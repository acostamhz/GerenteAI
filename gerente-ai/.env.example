# =============================================================================
# Luka AI — configuracion del backend
# Copia este archivo como .env y ajusta los valores.
# =============================================================================

PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/business_ai


# =============================================================================
# PROVEEDOR DE IA
# -----------------------------------------------------------------------------
# Cambiar de IA = cambiar AI_PROVIDER y su llave. Ninguna otra linea de codigo
# se toca. Opciones: groq | gemini | openrouter | ollama | anthropic | openai |
#                    deepseek | echo
# =============================================================================

# --- Opcion 0: sin configurar nada (arranca y responde, pero simulado) -------
AI_PROVIDER=echo

# --- Opcion 1 (recomendada para pruebas): Groq — gratis y muy rapido ---------
# Llave gratuita en https://console.groq.com/keys
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# AI_MODEL=llama-3.3-70b-versatile

# --- Opcion 2: Google Gemini — gratis, mejor espanol y JSON con esquema ------
# Llave gratuita en https://aistudio.google.com/apikey
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# AI_MODEL=gemini-2.0-flash

# --- Opcion 3: Ollama — 100% local, costo cero, datos que no salen del equipo -
# Requiere `ollama serve` y `ollama pull llama3.1:8b`
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1:8b
# AI_BASE_URL=http://localhost:11434/v1

# --- Opcion 4 (produccion): Anthropic / Claude — de pago --------------------
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5
# Modelos mas economicos: claude-sonnet-5 | claude-haiku-4-5


# --- Proveedor de respaldo (opcional) ----------------------------------------
# Si el principal falla por saturacion o caida, se usa este automaticamente.
# AI_FALLBACK_PROVIDER=groq
# AI_FALLBACK_API_KEY=gsk_...
# AI_FALLBACK_MODEL=llama-3.1-8b-instant


# --- Ajustes comunes ---------------------------------------------------------
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=3
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.2

# Registra prompts y respuestas completas en los logs.
# Dejar en false: contienen datos financieros de los clientes.
AI_LOG_PROMPTS=false

# Solo Anthropic: si los clasificadores rechazan una peticion, el API la
# reintenta en otro modelo de Anthropic en la misma llamada.
ANTHROPIC_SERVER_FALLBACK=true
